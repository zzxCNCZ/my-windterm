{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My WindTerm",
  "version": "1.1.4",
  "identifier": "local.my-windterm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "My WindTerm", "width": 1320, "height": 830, "minWidth": 900, "minHeight": 570 }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; frame-src 'none'; object-src 'none'",
      "capabilities": [{ "identifier": "main-local", "windows": ["main"], "permissions": ["dialog:allow-open"] }]
    }
  },
  "bundle": { "active": true, "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"] },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMjZERjlFNzEyQkI4NDcKUldSSHVDdHhudDhtWWVaL0xOdytUSUQ1TjFpYXdsYktubFBqZ3c0YzFrRys4VkkrQUxpS3cyV2cK",
      "endpoints": ["https://github.com/zzxCNCZ/my-windterm/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
